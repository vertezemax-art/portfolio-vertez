# Получите значения при создании проекта в Sanity Manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Используется только для предпросмотра черновиков на сервере. Не добавляйте его в NEXT_PUBLIC_*.
SANITY_API_READ_TOKEN=
# Токен Sanity с разрешением Editor — только для scripts/seed.ts. Никогда не добавляйте его в NEXT_PUBLIC_*.
SANITY_API_TOKEN=
